# Database — Neon Postgres (ark-flow database)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.neon.tech/arkflow?sslmode=require&channel_binding=require
DATABASE_URL_DIRECT=postgresql://neondb_owner:password@ep-xxx.neon.tech/arkflow?sslmode=require

# Auth
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRY=7d

# AI — Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# API
PORT=3001
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
